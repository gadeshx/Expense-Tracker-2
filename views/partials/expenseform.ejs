<label for="amount">Amount:</label>
<input id="amount" type="number" name="amount" min="0.01" max="99999999" step="0.01" required
    value="<%= values?.amount || '' %>">

<label for="category">Category:</label>
<select id="category" name="category" required>
    <option value="">--Please choose a category--</option>
    <% categoryOptions.forEach(option=> { %>
        <option value="<%= option %>" <%=values?.category===option ? "selected" : "" %>>
            <%= option %>
        </option>
        <% }) %>
</select>

<label for="description">Description:</label>
<input type="text" name="description" id="description" maxlength="50" value="<%= values?.description || '' %>">

<label for="date">Date:</label>
<input id="date" type="date" name="date" required value="<%= values?.date || '' %>">